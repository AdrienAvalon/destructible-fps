{
  "bind": "127.0.0.1:40000",
  "exposure": "loopback",
  "certificate_chain_file": "/etc/destructible-fps/tls/server-chain.pem",
  "private_key_file": "/run/secrets/destructible-fps-server-key.pem",
  "oidc_jwks_file": "/var/lib/destructible-fps/oidc-jwks.json",
  "oidc_issuer": "https://identity.example.test/realms/game",
  "oidc_audience": "destructible-fps",
  "jwks_valid_until_unix_seconds": 0,
  "tls_reload": {
    "interval_seconds": 60
  }
}
